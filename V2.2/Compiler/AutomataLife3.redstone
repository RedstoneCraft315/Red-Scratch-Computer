import <Libraries\BLOB.asm>

XCursor     = 7FFD
YCursor     = 7FFE
CursorColor = 7FFF

XCursorMod = 0000
ShiftedMod = 0001
CellState  = 0002

CalcRAMAddress = 0003


MemoryOffset = 2000


LDA F000
ATR CursorColor

LDA FFFF
ATR XCursor

Draw:
RTA XCursor
LDB 0001
ADD
CTR XCursor
RTA XCursor
LDB 0008
SHR
CTR YCursor



RTA XCursor
LDB 0010
MOD
CTR XCursorMod

LDA 8000
RTB XCursorMod
SHR
CTR ShiftedMod


RTA XCursor
LDB 0010
DIV
CTR CalcRAMAddress
RTA CalcRAMAddress
LDB MemoryOffset
ADD
CTR CalcRAMAddress

LRA CalcRAMAddress 0
RTB ShiftedMod
AND
CTR CellState

RTA CellState
RTB XCursorMod
SHL
CTR CellState

RTA CellState
LDB 0001
SRL
CTR CursorColor

RTA CursorColor
LDB FFFF
MLT
CTR CursorColor



RTD 0 0
JMP Draw



