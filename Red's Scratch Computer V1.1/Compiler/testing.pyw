def render_char(ch):
    g = font_10x8.get(ch, font_10x8[" "])
    for row in g:
        line = ""
        for bit in range(7,-1,-1):
            line += "#" if (row >> bit) & 1 else " "
        print(line)
    print()

# Example: render "HELLO 123"
for ch in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
    render_char(ch)
